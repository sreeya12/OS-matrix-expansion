 184 |     @Test
 185 |     public void testRemoveWatchInBackgroundWithCallback() throws Exception {
 186 |         Timing timing = new Timing();
 187 |         CuratorFramework client = CuratorFrameworkFactory.builder()
 188 |                 .connectString(server.getConnectString())
 189 |                 .retryPolicy(new RetryOneTime(1))
 190 |                 .build();
 191 |         try {
 192 |             client.start();
 193 | 
 194 |             // Make sure that the event fires on both the watcher and the callback.
 195 |             final CountDownLatch removedLatch = new CountDownLatch(2);
 196 |             final String path = "/";
 197 |             Watcher watcher = new CountDownWatcher(path, removedLatch, EventType.DataWatchRemoved);
 198 | 
 199 |             BackgroundCallback callback = new BackgroundCallback() {
 200 | 
 201 |                 @Override
 202 |                 public void processResult(CuratorFramework client, CuratorEvent event) throws Exception {
 203 |                     if (event.getType() == CuratorEventType.REMOVE_WATCHES
 204 |                             && event.getPath().equals(path)) {
 205 |                         removedLatch.countDown();
 206 |                     }
 207 |                 }
 208 |             };
 209 | 
 210 |             client.checkExists().usingWatcher(watcher).forPath(path);
 211 | 
 212 |             client.watches()
 213 |                     .remove(watcher)
 214 |                     .ofType(WatcherType.Any)
 215 |                     .inBackground(callback)
 216 |                     .forPath(path);
 217 | 
 218 |             assertTrue(timing.awaitLatch(removedLatch), "Timed out waiting for watch removal");
 219 | 
 220 |         } finally {
 221 |             CloseableUtils.closeQuietly(client);
 222 |         }
 223 |     }
