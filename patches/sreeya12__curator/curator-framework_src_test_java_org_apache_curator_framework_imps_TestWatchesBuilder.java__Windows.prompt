 712 | 
 713 |         public BooleanWatcher(String path, AtomicBoolean removedFlag, EventType eventType) {
 714 |             this.path = path;
 715 |             this.eventType = eventType;
 716 |             this.removedFlag = removedFlag;
 717 |         }
 718 | 
 719 |         @Override
 720 |         public void process(WatchedEvent event) {
 721 |             if (event.getPath() == null || event.getType() == null) {
 722 |                 return;
 723 |             }
 724 | 
 725 |             if (event.getPath().equals(path) && event.getType() == eventType) {
 726 |                 removedFlag.set(true);
 727 |             }
 728 |         }
 729 |     }
