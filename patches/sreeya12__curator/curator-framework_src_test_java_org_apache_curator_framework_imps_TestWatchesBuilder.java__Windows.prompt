 501 |     @Test
 502 |     public void testGuaranteedRemoveWatchInBackground() throws Exception {
 503 |         Timing timing = new Timing();
 504 |         CuratorFramework client = CuratorFrameworkFactory.newClient(
 505 |                 server.getConnectString(), timing.session(), timing.connection(), new ExponentialBackoffRetry(100, 3));
 506 |         try {
 507 |             client.start();
 508 | 
 509 |             AtomicReference<ConnectionState> stateRef = registerConnectionStateListener(client);
 510 | 
 511 |             final CountDownLatch guaranteeAddedLatch = new CountDownLatch(1);
 512 | 
 513 |             ((CuratorFrameworkBase) client).getFailedRemoveWatcherManager().debugListener =
 514 |                     new FailedOperationManager.FailedOperationManagerListener<
 515 |                             FailedRemoveWatchManager.FailedRemoveWatchDetails>() {
 516 | 
 517 |                         @Override
 518 |                         public void pathAddedForGuaranteedOperation(FailedRemoveWatchDetails detail) {
 519 |                             guaranteeAddedLatch.countDown();
 520 |                         }
 521 |                     };
 522 | 
 523 |             String path = "/";
 524 | 
 525 |             CountDownLatch removeLatch = new CountDownLatch(1);
 526 | 
 527 |             Watcher watcher = new CountDownWatcher(path, removeLatch, EventType.DataWatchRemoved);
 528 |             client.checkExists().usingWatcher(watcher).forPath(path);
 529 | 
 530 |             server.stop();
 531 |             assertTrue(blockUntilDesiredConnectionState(stateRef, timing, ConnectionState.SUSPENDED));
 532 | 
 533 |             // Remove the watch while we're not connected
 534 |             client.watches().remove(watcher).guaranteed().inBackground().forPath(path);
 535 | 
 536 |             timing.awaitLatch(guaranteeAddedLatch);
 537 | 
 538 |             server.restart();
 539 | 
 540 |             timing.awaitLatch(removeLatch);
 541 |         } finally {
 542 |             CloseableUtils.closeQuietly(client);
 543 |         }
 544 |     }
