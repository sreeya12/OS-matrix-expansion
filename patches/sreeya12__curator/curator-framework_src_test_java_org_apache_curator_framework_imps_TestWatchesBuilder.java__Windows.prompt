 462 |     @Test
 463 |     public void testGuaranteedRemoveWatch() throws Exception {
 464 |         Timing timing = new Timing();
 465 |         CuratorFramework client = CuratorFrameworkFactory.builder()
 466 |                 .connectString(server.getConnectString())
 467 |                 .retryPolicy(new RetryOneTime(1))
 468 |                 .build();
 469 |         try {
 470 |             client.start();
 471 | 
 472 |             AtomicReference<ConnectionState> stateRef = registerConnectionStateListener(client);
 473 | 
 474 |             String path = "/";
 475 | 
 476 |             CountDownLatch removeLatch = new CountDownLatch(1);
 477 | 
 478 |             Watcher watcher = new CountDownWatcher(path, removeLatch, EventType.DataWatchRemoved);
 479 |             client.checkExists().usingWatcher(watcher).forPath(path);
 480 | 
 481 |             server.stop();
 482 | 
 483 |             assertTrue(blockUntilDesiredConnectionState(stateRef, timing, ConnectionState.SUSPENDED));
 484 | 
 485 |             // Remove the watch while we're not connected
 486 |             try {
 487 |                 client.watches().remove(watcher).guaranteed().forPath(path);
 488 |                 fail();
 489 |             } catch (KeeperException.ConnectionLossException e) {
 490 |                 // Expected
 491 |             }
 492 | 
 493 |             server.restart();
 494 | 
 495 |             timing.awaitLatch(removeLatch);
 496 |         } finally {
 497 |             CloseableUtils.closeQuietly(client);
 498 |         }
 499 |     }
