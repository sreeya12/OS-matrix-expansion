 685 |     private static class CountDownWatcher implements Watcher {
 686 |         private String path;
 687 |         private EventType eventType;
 688 |         private CountDownLatch removeLatch;
 689 | 
 690 |         public CountDownWatcher(String path, CountDownLatch removeLatch, EventType eventType) {
 691 |             this.path = path;
 692 |             this.eventType = eventType;
 693 |             this.removeLatch = removeLatch;
 694 |         }
 695 | 
 696 |         @Override
 697 |         public void process(WatchedEvent event) {
 698 |             if (event.getPath() == null || event.getType() == null) {
 699 |                 return;
 700 |             }
 701 | 
 702 |             if (event.getPath().equals(path) && event.getType() == eventType) {
 703 |                 removeLatch.countDown();
 704 |             }
 705 |         }
 706 |     }
 707 | 
