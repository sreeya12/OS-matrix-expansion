  55 |     private AtomicReference<ConnectionState> registerConnectionStateListener(CuratorFramework client) {
  56 |         final AtomicReference<ConnectionState> state = new AtomicReference<ConnectionState>();
  57 |         client.getConnectionStateListenable().addListener(new ConnectionStateListener() {
  58 | 
  59 |             @Override
  60 |             public void stateChanged(CuratorFramework client, ConnectionState newState) {
  61 |                 state.set(newState);
  62 |                 synchronized (state) {
  63 |                     state.notify();
  64 |                 }
  65 |             }
  66 |         });
  67 | 
  68 |         return state;
  69 |     }
  70 | 
  71 |     private boolean blockUntilDesiredConnectionState(
  72 |             AtomicReference<ConnectionState> stateRef, Timing timing, final ConnectionState desiredState) {
  73 |         if (stateRef.get() == desiredState) {
  74 |             return true;
  75 |         }
  76 | 
  77 |         //noinspection SynchronizationOnLocalVariableOrMethodParameter
  78 |         synchronized (stateRef) {
  79 |             if (stateRef.get() == desiredState) {
  80 |                 return true;
  81 |             }
  82 | 
  83 |             try {
  84 |                 stateRef.wait(timing.milliseconds());
  85 |                 return stateRef.get() == desiredState;
  86 |             } catch (InterruptedException e) {
  87 |                 Thread.currentThread().interrupt();
  88 |                 return false;
  89 |             }
  90 |         }
  91 |     }
