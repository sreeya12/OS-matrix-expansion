 547 |     @Tag(CuratorTestBase.zk36Group)
 548 |     public void testPersistentWatch() throws Exception {
 549 |         try (CuratorFramework client =
 550 |                 CuratorFrameworkFactory.newClient(server.getConnectString(), new RetryOneTime(1))) {
