 335 |     @Test
 336 |     public void testRemoveLocalWatch() throws Exception {
 337 |         Timing timing = new Timing();
 338 |         CuratorFramework client = CuratorFrameworkFactory.builder()
 339 |                 .connectString(server.getConnectString())
 340 |                 .retryPolicy(new RetryOneTime(1))
 341 |                 .build();
 342 |         try {
 343 |             client.start();
 344 | 
 345 |             AtomicReference<ConnectionState> stateRef = registerConnectionStateListener(client);
 346 | 
 347 |             final String path = "/";
 348 | 
 349 |             final CountDownLatch removedLatch = new CountDownLatch(1);
 350 | 
 351 |             Watcher watcher = new CountDownWatcher(path, removedLatch, EventType.DataWatchRemoved);
 352 | 
 353 |             client.checkExists().usingWatcher(watcher).forPath(path);
 354 | 
 355 |             // Stop the server so we can check if we can remove watches locally when offline
 356 |             server.stop();
 357 | 
 358 |             assertTrue(blockUntilDesiredConnectionState(stateRef, timing, ConnectionState.SUSPENDED));
 359 | 
 360 |             client.watches().removeAll().locally().forPath(path);
 361 | 
 362 |             assertTrue(timing.awaitLatch(removedLatch), "Timed out waiting for watch removal");
 363 |         } finally {
 364 |             CloseableUtils.closeQuietly(client);
 365 |         }
 366 |     }
